# name|api_key|db_uri|db_type|db_label
#
# `run_context_file: true` (which the datavalgen-model-beach algorithm
# requires) only supports local file-backed databases, so db_type is always
# csv here. __REPO_ROOT__ must be replaced with this repo's absolute path
# before use (the CI workflow does this automatically; for local runs, sed
# it to $(pwd) yourself). See tests/infra/README.md.
siteclean|11111111-1111-4111-8111-111111111111|__REPO_ROOT__/data/202604_synthetic/splits_by_centre/maastricht.csv|csv|default
sitebad|22222222-2222-4222-8222-222222222222|__REPO_ROOT__/tests/fixtures/invalid.csv|csv|default
