# Lean defaults for running datavalgen-model-beach through v6-infrastructure-sh.
# See tests/infra/README.md.
#
# DOCKER_REGISTRY is deliberately left unset here, unlike
# strata-fit-v6-statistics-py's own config.env (which points it at a local
# mirror): that's for infra.sh's own server/node/ui images, which pull fine
# straight from the harness's default (ghcr.io/mdw-nl/vantage6/infrastructure)
# - no mirroring needed for those. A *different* local registry is still
# needed for our own algorithm image (vantage6 does an unconditional `docker
# pull`, which fails for a purely local-only image) - run_algo_smoke.sh
# handles that itself.

ENVIRONMENT=CI
PYTHON_INTERPRETER=python3.12
VERSION_VANTAGE6=4.14.0
UI_ENABLED=false
SERVER_URL=http://host.docker.internal
COLLABORATION_NAME=datavalgen-beach-ci
